<script>window.COZY_THEMES = [{"slug": "rose", "icon": "🌹", "name": "장미 컬렉션", "flowers": ["수정빛 나비춤 장미", "황금 장미", "귤홍 윙윙 장미", "꾀꼬리 장미", "레몬색 윙윙 장미", "맑은 봉우리 장미", "아지랑이빛 장미", "주홍빛 윙윙 장미", "향설 목향장미", "진홍 벚꽃 나비무 장미", "붉은 눈 목향장미", "새벽빛 목향장미", "붉은 장미", "노란 장미", "분홍 장미", "탐스러운 덩굴장미"], "ids": ["F0048", "F0071", "F0074", "F0077", "F0082", "F0083", "F0102", "F0114", "F0127", "F0137", "F0156", "F0159", "F0260", "F0263", "F0269", "F0310"]}, {"slug": "sparkle", "icon": "✨", "name": "반짝이는 꽃", "flowers": ["꽃나무 정원", "동화의 성", "서리구름마", "푸른 사슴 그림자", "구름 조류 꽃무늬 배", "구름꿈 고래의 노래", "수정빛 나비춤 장미", "옥구슬 목련", "파스텔 꿈의 조개", "영롱한 얼음빛 납매", "진홍 벚꽃 나비무 장미", "쌓인 옥빛 연꽃", "유리빛 조류 연꽃", "바다색 꿈의 조개"], "ids": ["F0001", "F0002", "F0003", "F0004", "F0006", "F0007", "F0048", "F0054", "F0062", "F0135", "F0137", "F0161", "F0174", "F0329"]}, {"slug": "animal", "icon": "🐰", "name": "동물 친구 꽃", "flowers": ["서리구름마", "푸른 사슴 그림자", "골든 스프링", "곰 보이스 박스", "꽃밭 지저귐", "냥이의 즐거운 노래", "무지개 오리의 즐거운 산책", "별빛 레몬 토끼잔", "분홍빛 물결꽃", "비령추란", "연보라 환상 벚꽃", "연분홍 환상 벚꽃", "자색 여운", "차와 야옹 이야기", "푸른 물결의 춤", "해변 오리의 시원한 여름", "햇살구름 양털", "황금빛 단꿈", "반짝 솜토끼", "수박 스위트덕", "별빛 입맞춤 구름 양", "별을 쫓는 달토끼", "우주선 댕댕이", "귀염냥 연회", "분홍빛 생일잔치"], "ids": ["F0003", "F0004", "F0021", "F0022", "F0026", "F0028", "F0033", "F0038", "F0042", "F0044", "F0052", "F0053", "F0056", "F0060", "F0063", "F0067", "F0068", "F0072", "F0085", "F0331", "F0343", "F0347", "F0348", "F0357", "F0360"]}, {"slug": "bee-butterfly", "icon": "🦋", "name": "벌과 나비", "flowers": ["성란화의 언약", "귤홍 윙윙 장미", "따스한 여름 햇살", "레몬색 윙윙 장미", "주홍빛 윙윙 장미", "따뜻한 등불"], "ids": ["F0047", "F0074", "F0081", "F0082", "F0114", "F0366"]}, {"slug": "sea", "icon": "🌊", "name": "바다 내음 꽃", "flowers": ["구름꿈 고래의 노래", "파스텔 꿈의 조개", "별꿈 해파리", "창공빛 산호초", "바다색 꿈의 조개", "불꽃심장 꿈조개"], "ids": ["F0007", "F0062", "F0088", "F0119", "F0329", "F0351"]}, {"slug": "dessert", "icon": "🍰", "name": "달콤한 디저트 꽃", "flowers": ["꽃케이크 바구니", "별빛 레몬 토끼잔", "스노우 씰 샤베트", "심쿵 스위트 베리", "차와 야옹 이야기", "핑크 치즈 컵"], "ids": ["F0027", "F0038", "F0049", "F0050", "F0060", "F0065"]}];</script>
<script>(function () {
  var cards = Array.prototype.slice.call(document.querySelectorAll('#grid .fcard'));
  // statusOk = 기본 켜짐 (2026-08-09 교장님) — 칩 HTML의 class="on"과 세트
  var state = { q: '', statusOk: true, statusSoon: false, ending: false, f2p: false, sparkle: false,
    grade: [], score: [], colors: [], cat: [], tags: [], theme: null };
  var THEMES = window.COZY_THEMES || [];
  var themeSets = THEMES.map(function (t) {
    var s = {}; t.flowers.forEach(function (n) { s[n] = 1; }); return s;
  });

  function match(c) {
    var d = c.dataset;
    if (state.theme !== null && !themeSets[state.theme][d.name]) return false;
    if (state.q && d.name.toLowerCase().indexOf(state.q) < 0) return false;
    if (state.statusOk && d.status !== 'ok') return false;
    if (state.statusSoon && d.status !== 'soon') return false;
    if (state.ending && (d.dday === '' || +d.dday > 3)) return false; // 곧 끝나요 = 3일 이내 종료 (D-7→D-3, 2026-08-15 교장님)
    if (state.f2p && d.f2p !== '1') return false;
    if (state.sparkle && d.sparkle !== '1') return false;
    if (state.grade.length && state.grade.indexOf(d.grade) < 0) return false;
    if (state.score.length && state.score.indexOf(d.score) < 0) return false;
    if (state.cat.length && state.cat.indexOf(d.cat) < 0) return false;
    if (state.colors.length) {
      var cs = d.colors ? d.colors.split(',') : [];
      if (!state.colors.some(function (v) { return cs.indexOf(v) >= 0; })) return false;
    }
    if (state.tags.length) {
      var ts = d.tags ? d.tags.split(',') : [];
      if (!state.tags.some(function (v) { return ts.indexOf(v) >= 0; })) return false;
    }
    return true;
  }

  function anyFilter() {
    return !!(state.q || state.statusOk || state.statusSoon || state.ending || state.f2p || state.sparkle ||
      state.grade.length || state.score.length || state.colors.length || state.cat.length || state.tags.length);
  }

  function apply() {
    var n = 0;
    cards.forEach(function (c) {
      var ok = match(c);
      c.style.display = ok ? '' : 'none';
      if (ok) n++;
    });
    document.getElementById('count').textContent = n + '송이';
    document.getElementById('empty').hidden = n > 0;
    var rb = document.getElementById('resetFilters');
    if (rb) rb.hidden = !anyFilter();
  }

  function sortBy(mode) {
    var grid = document.getElementById('grid');
    var key = { new: function (c) { return -c.dataset.num; },
      score: function (c) { return -parseInt(c.dataset.score, 10); },
      name: function (c) { return c.dataset.name; } }[mode];
    cards.slice().sort(function (a, b) {
      var x = key(a), y = key(b);
      return x < y ? -1 : x > y ? 1 : 0;
    }).forEach(function (c) { grid.appendChild(c); });
  }

  // 발견 컬렉션: 테마 = 도감 위에 얹는 모아보기 (일반 필터와 조합 가능)
  function setTheme(i) {
    state.theme = i;
    document.querySelectorAll('.tcard[data-theme]').forEach(function (b) {
      b.classList.toggle('on', +b.dataset.theme === i);
    });
    var title = document.getElementById('dexTitle');
    var reset = document.getElementById('themeReset');
    if (i === null) {
      title.textContent = '📖 전체 꽃';
      reset.hidden = true;
      history.replaceState(null, '', location.pathname);
    } else {
      var th = THEMES[i];
      title.textContent = th.icon + ' ' + th.name + ' 모아보기';
      reset.hidden = false;
      history.replaceState(null, '', location.pathname + '?theme=' + th.slug);
    }
    apply();
  }
  document.querySelectorAll('.tcard[data-theme]').forEach(function (b) {
    b.addEventListener('click', function () {
      setTheme(b.classList.contains('on') ? null : +b.dataset.theme);
    });
  });
  var themeReset = document.getElementById('themeReset');
  if (themeReset) themeReset.addEventListener('click', function () { setTheme(null); });

  // ? 도움말 토글 — 카드 표시 안내
  var helpBtn = document.getElementById('helpBtn');
  if (helpBtn) helpBtn.addEventListener('click', function () {
    var lg = document.getElementById('legend');
    lg.hidden = !lg.hidden;
    helpBtn.classList.toggle('on', !lg.hidden);
  });

  document.getElementById('search').addEventListener('input', function (e) {
    state.q = e.target.value.trim().toLowerCase();
    apply();
  });
  document.getElementById('sort').addEventListener('change', function (e) { sortBy(e.target.value); });

  document.querySelectorAll('.chip[data-filter]').forEach(function (b) {
    b.addEventListener('click', function () {
      b.classList.toggle('on');
      var f = b.dataset.filter;
      // 지금 얻을 수 있어요 ↔ 예정 꽃 = 상호 배타 (둘 다 켜지면 결과 0이라 한쪽 자동 해제)
      if (f === 'status-ok') {
        state.statusOk = b.classList.contains('on');
        if (state.statusOk) {
          state.statusSoon = false;
          var sb = document.querySelector('.chip[data-filter="status-soon"]');
          if (sb) sb.classList.remove('on');
        }
      }
      if (f === 'status-soon') {
        state.statusSoon = b.classList.contains('on');
        if (state.statusSoon) {
          state.statusOk = false; state.ending = false;
          ['status-ok', 'ending'].forEach(function (k) {
            var c = document.querySelector('.chip[data-filter="' + k + '"]');
            if (c) c.classList.remove('on');
          });
        }
      }
      if (f === 'ending') {
        state.ending = b.classList.contains('on');
        if (state.ending) { // 곧 끝나요 = 지금 획득 가능의 부분집합 → 예정과는 배타
          state.statusSoon = false;
          var eb = document.querySelector('.chip[data-filter="status-soon"]');
          if (eb) eb.classList.remove('on');
          // 마감 임박한 순서로 정렬
          var grid = document.getElementById('grid');
          cards.slice().sort(function (a, b2) {
            return (+a.dataset.dday || 9999) - (+b2.dataset.dday || 9999);
          }).forEach(function (c) { grid.appendChild(c); });
        }
      }
      if (f === 'f2p') state.f2p = b.classList.contains('on');
      if (f === 'sparkle') state.sparkle = b.classList.contains('on');
      apply();
    });
  });
  document.querySelectorAll('.chip.toggle').forEach(function (b) {
    b.addEventListener('click', function () {
      var g = b.dataset.toggle;
      var row = document.getElementById('sub-' + g);
      row.hidden = !row.hidden;
      if (row.hidden) { // 다시 누르면 접히면서 선택도 함께 해제 (2026-08-09 교장님)
        if (state[g] && state[g].length) {
          state[g] = [];
          row.querySelectorAll('.chip.on').forEach(function (c) { c.classList.remove('on'); });
          apply();
        }
      }
      b.classList.toggle('on', !row.hidden);
    });
  });
  document.querySelectorAll('.chip.sub[data-group]').forEach(function (b) {
    b.addEventListener('click', function () {
      b.classList.toggle('on');
      var g = b.dataset.group, v = b.dataset.value;
      var i = state[g].indexOf(v);
      if (i >= 0) state[g].splice(i, 1); else state[g].push(v);
      apply();
    });
  });

  // ↺ 필터 해제 — 필터·검색이 하나라도 켜져 있을 때만 노출 (2026-08-09 교장님)
  var resetBtn = document.getElementById('resetFilters');
  if (resetBtn) resetBtn.addEventListener('click', function () {
    state.q = ''; state.statusOk = state.statusSoon = state.ending = state.f2p = state.sparkle = false;
    state.grade = []; state.score = []; state.colors = []; state.cat = []; state.tags = [];
    document.getElementById('search').value = '';
    document.querySelectorAll('.chip.on').forEach(function (b) { b.classList.remove('on'); });
    document.querySelectorAll('.chip-sub-row').forEach(function (r) { r.hidden = true; });
    apply();
  });

  // 상세 페이지 칩 → ?family=… 형태로 진입 시 필터 프리셋
  // (cat·tags는 칩 UI가 없어졌지만 상세 칩 링크가 쓰므로 상태로만 적용)
  var params = new URLSearchParams(location.search);
  ['grade', 'colors', 'cat', 'tags'].forEach(function (g) {
    var v = params.get(g);
    if (!v) return;
    state[g].push(v);
    var btn = document.querySelector('.chip.sub[data-group="' + g + '"][data-value="' + v + '"]');
    if (btn) {
      document.getElementById('sub-' + g).hidden = false;
      btn.classList.add('on');
    }
    apply();
  });
  if (params.get('family')) {
    // 계열은 칩 그룹이 없으므로 검색어처럼 처리하지 않고 데이터 필터로만
    var fam = params.get('family');
    cards.forEach(function (c) { if (c.dataset.family !== fam) c.style.display = 'none'; });
    document.getElementById('count').textContent =
      cards.filter(function (c) { return c.dataset.family === fam; }).length + '송이';
  }
  if (params.get('sparkle')) { state.sparkle = true; }
  if (!params.get('family')) apply(); // 기본 필터(지금 얻을 수 있어요) 첫 화면부터 적용
  // ?theme=slug — 인스타 등에서 컬렉션으로 바로 진입
  if (params.get('theme')) {
    THEMES.forEach(function (t, i) { if (t.slug === params.get('theme')) setTheme(i); });
  }
})();

// ── ✓/♡ 내 수첩 마킹 (localStorage, TABS-IA-SPEC 2026-08-09) ──
(function () {
  var grid = document.getElementById('grid');
  if (!grid) return;
  function load(k) { try { return JSON.parse(localStorage.getItem(k) || '[]'); } catch (e) { return []; } }
  function save(k, a) { localStorage.setItem(k, JSON.stringify(a)); }
  var KEY = { own: 'cozy_own', wish: 'cozy_wish' };
  function paint(card) {
    var fid = card.dataset.fid;
    ['own', 'wish'].forEach(function (m) {
      var b = card.querySelector('.mk-' + m);
      if (b) b.classList.toggle('on', load(KEY[m]).indexOf(fid) >= 0);
    });
  }
  Array.prototype.forEach.call(document.querySelectorAll('#grid .fcard'), paint);
  grid.addEventListener('click', function (e) {
    var b = e.target.closest('.mk');
    if (!b) return;
    e.preventDefault(); e.stopPropagation();
    var card = b.closest('.fcard'), fid = card.dataset.fid, k = KEY[b.dataset.mk];
    var a = load(k), i = a.indexOf(fid);
    if (i >= 0) a.splice(i, 1); else a.push(fid);
    save(k, a); paint(card);
  });
})();
</script>
</body>
</html>